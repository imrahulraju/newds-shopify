<section class="featured-collection section{% if section.settings.bg_image != blank %} has-bg-image{% endif %}" style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% elsif section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  {% if section.settings.bg_image != blank and section.settings.bg_overlay_opacity > 0 %}
    <div class="section-bg-overlay" style="background-color: {{ section.settings.bg_overlay_color | default: '#ffffff' }}; opacity: {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }};"></div>
  {% endif %}
  <div class="container">
    {% if section.settings.title != blank %}
      <div class="section__header">
        {% if section.settings.subtitle != blank %}
          <p class="section__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
        <h2 class="section__title">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.products_to_show -%}

    <div class="featured-collection__slider-container">
      <button type="button" class="featured-collection__arrow featured-collection__arrow--prev" data-feat-prev aria-label="Previous products">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="featured-collection__slider" data-featured-slider data-animate-grid>
        {% if collection != blank %}
          {% for product in collection.products limit: limit %}
            <div class="featured-collection__slider-item">
              {% render 'product-card', product: product, show_sale_badge: section.settings.show_sale_badge %}
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..limit) %}
            <div class="featured-collection__slider-item">
              {% render 'product-card-placeholder' %}
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <button type="button" class="featured-collection__arrow featured-collection__arrow--next" data-feat-next aria-label="Next products">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {% if section.settings.show_view_all and collection != blank %}
      <div class="section__footer">
        <a href="{{ collection.url }}" class="btn btn--secondary">
          {{ 'collections.general.view_all' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "40% Off"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Limited time offer on selected pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Background & Style"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 10,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
