<section class="product-template section{% if section.settings.bg_image != blank %} has-bg-image{% endif %}" style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% elsif section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  {% if section.settings.bg_image != blank and section.settings.bg_overlay_opacity > 0 %}
    <div class="section-bg-overlay" style="background-color: {{ section.settings.bg_overlay_color | default: '#ffffff' }}; opacity: {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }};"></div>
  {% endif %}
  <div class="container">
    <div class="product-template__inner">
      <!-- Product Gallery -->
      <div class="product-template__gallery">
        <div class="product-template__main-image" data-product-main-image>
          {% if product.featured_image %}
            <img 
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | default: product.title }}"
              width="800"
              height="800"
              class="product-template__image"
              id="product-main-img"
              onerror="this.onerror=null; this.src='{{ 'sample-product-1.jpg' | asset_url }}';"
            >
          {% else %}
            <img 
              src="{{ 'sample-product-1.jpg' | asset_url }}"
              alt="{{ product.title | default: 'Fine Jewelry' }}"
              width="800"
              height="800"
              class="product-template__image"
              id="product-main-img"
            >
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="product-template__thumbnails">
            {% for image in product.images %}
              <button 
                class="product-template__thumbnail {% if forloop.first %}is-active{% endif %}"
                data-thumbnail
                data-image-url="{{ image | image_url: width: 800 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img 
                  src="{{ image | image_url: width: 120 }}"
                  alt="{{ image.alt | default: product.title }}"
                  width="120"
                  height="120"
                  loading="lazy"
                >
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div class="product-template__info">
        <div class="product-template__breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          {% if collection %}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
            <span>/</span>
          {% endif %}
          <span>{{ product.title }}</span>
        </div>

        <h1 class="product-template__title">{{ product.title }}</h1>

        <div class="product-template__price" data-product-price>
          {% if product.compare_at_price > product.price %}
            <span class="product-template__price-sale">{{ product.price | money }}</span>
            <span class="product-template__price-compare">{{ product.compare_at_price | money }}</span>
            <span class="product-template__price-badge">Sale</span>
          {% else %}
            <span class="product-template__price-regular">{{ product.price | money }}</span>
          {% endif %}
        </div>

        {% if product.metafields.reviews.rating.value %}
          <div class="product-template__rating">
            {% render 'star-rating', rating: product.metafields.reviews.rating.value %}
            <span class="product-template__rating-count">({{ product.metafields.reviews.rating_count.value }} reviews)</span>
          </div>
        {% endif %}

        <div class="product-template__description">
          {{ product.description }}
        </div>

        {% form 'product', product, data-product-form: '' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="product-template__option">
                <label class="product-template__option-label">
                  {{ option.name }}
                </label>
                <div class="product-template__option-values">
                  {% for value in option.values %}
                    <button 
                      type="button"
                      class="product-template__option-btn {% if option.selected_value == value %}is-active{% endif %}"
                      data-option-value="{{ value }}"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <div class="product-template__quantity">
            <label class="product-template__quantity-label">Quantity</label>
            <div class="product-template__quantity-selector">
              <button type="button" class="product-template__qty-btn" data-qty-minus aria-label="Decrease quantity">-</button>
              <input type="number" name="quantity" value="1" min="1" class="product-template__qty-input" data-qty-input aria-label="Quantity">
              <button type="button" class="product-template__qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div class="product-template__actions">
            <button 
              type="submit" 
              class="btn btn--primary btn--full product-template__add-btn"
              {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
              data-add-to-cart
            >
              {% if product.selected_or_first_available_variant.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </div>
        {% endform %}

        <!-- Product Meta -->
        <div class="product-template__meta">
          {% if product.vendor != blank %}
            <p class="product-template__vendor">Brand: <strong>{{ product.vendor }}</strong></p>
          {% endif %}
          {% if product.type != blank %}
            <p class="product-template__type">Type: <strong>{{ product.type }}</strong></p>
          {% endif %}
          <p class="product-template__sku" data-product-sku>
            SKU: <strong>{{ product.selected_or_first_available_variant.sku | default: 'N/A' }}</strong>
          </p>
        </div>

        <!-- Product Share -->
        {% if section.settings.show_share_buttons %}
          <div class="product-template__share">
            <span class="product-template__share-label">Share:</span>
            <div class="product-template__share-buttons">
              <!-- Facebook Share -->
              <a 
                href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url }}" 
                target="_blank" 
                rel="noopener" 
                class="product-template__share-btn" 
                aria-label="Share on Facebook"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/>
                </svg>
              </a>

              <!-- Twitter Share -->
              <a 
                href="https://twitter.com/intent/tweet?text={{ product.title | url_encode }}&url={{ shop.url | append: product.url }}" 
                target="_blank" 
                rel="noopener" 
                class="product-template__share-btn" 
                aria-label="Share on Twitter"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>

              <!-- Pinterest Pin -->
              <a 
                href="https://pinterest.com/pin/create/button/?url={{ shop.url | append: product.url }}&media={{ product.featured_image | image_url: width: 800 }}&description={{ product.description | strip_html | truncate: 150 | url_encode }}" 
                target="_blank" 
                rel="noopener" 
                class="product-template__share-btn" 
                aria-label="Pin on Pinterest"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12c0 4.22 2.62 7.83 6.35 9.31-.09-.79-.17-2 .03-2.86.19-.78 1.2-5.17 1.2-5.17s-.3-.61-.3-1.5c0-1.41.82-2.46 1.83-2.46.86 0 1.28.65 1.28 1.43 0 .87-.55 2.17-.84 3.37-.24 1.01.5 1.83 1.49 1.83 1.79 0 3.17-1.89 3.17-4.62 0-2.42-1.74-4.11-4.22-4.11-2.88 0-4.57 2.16-4.57 4.39 0 .87.33 1.8 1.01 2.37.1.08.11.15.08.27-.08.35-.27 1.12-.31 1.27-.05.21-.17.26-.39.16-1.45-.67-2.35-2.79-2.35-4.49 0-3.66 2.66-7.02 7.67-7.02 4.03 0 7.16 2.87 7.16 6.71 0 4-2.52 7.22-6.02 7.22-1.18 0-2.28-.61-2.66-1.33 0 0-.58 2.21-.72 2.76-.26.99-.97 2.23-1.44 3-.99.3 2.04.47 3.12.47 5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
                </svg>
              </a>

              <!-- Copy Link -->
              <button 
                type="button" 
                class="product-template__share-btn" 
                data-share-copy-link 
                data-share-url="{{ shop.url | append: product.url }}"
                aria-label="Copy Page Link"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
                <span class="copy-tooltip">Copied!</span>
              </button>
            </div>
          </div>
        {% endif %}

        <!-- Accordion -->
        <div class="product-template__accordions">
          {% for block in section.blocks %}
            {% if block.type == 'accordion' %}
              <details class="product-template__accordion" {{ block.shopify_attributes }}>
                <summary class="product-template__accordion-title">
                  {{ block.settings.title }}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </summary>
                <div class="product-template__accordion-content">
                  {{ block.settings.content }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

{% schema %}
{
  "name": "Product Template",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Background & Style"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 10,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free shipping on orders over $75. Returns accepted within 30 days.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
