<section class="collection-template section">
  <div class="container">

    <!-- ===== TOOLBAR ===== -->
    <div class="collection-template__toolbar">
      <div class="collection-template__toolbar-left">
        <!-- Mobile filter toggle -->
        <button class="filter-toggle-btn" data-filter-toggle aria-expanded="false" aria-controls="filter-sidebar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M3 6H21M6 12H18M10 18H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Filters
          {%- assign active_filter_count = 0 -%}
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value or filter.max_value.value -%}
                {%- assign active_filter_count = active_filter_count | plus: 1 -%}
              {%- endif -%}
            {%- else -%}
              {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign active_filter_count = active_filter_count | plus: current_tags.size -%}
          {% if active_filter_count > 0 %}
            <span class="filter-toggle-btn__count">{{ active_filter_count }}</span>
          {% endif %}
        </button>
        <p class="collection-template__count">
          {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
        </p>
      </div>

      <div class="collection-template__sort">
        <label for="sort-select" class="visually-hidden">Sort by</label>
        <select id="sort-select" class="collection-template__sort-select" data-sort-select>
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>

    <!-- ===== ACTIVE FILTER PILLS ===== -->
    {%- assign has_active_filters = false -%}
    {%- for filter in collection.filters -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value or filter.max_value.value -%}
          {%- assign has_active_filters = true -%}
        {%- endif -%}
      {%- elsif filter.active_values.size > 0 -%}
        {%- assign has_active_filters = true -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if current_tags.size > 0 -%}
      {%- assign has_active_filters = true -%}
    {%- endif -%}

    {% if has_active_filters %}
      <div class="active-filters">
        <span class="active-filters__label">Active:</span>
        <div class="active-filters__pills">
          {% for filter in collection.filters %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value or filter.max_value.value %}
                <a href="{{ filter.url_to_remove }}" class="active-filter-pill">
                  Price:
                  {% if filter.min_value.value %}{{ filter.min_value.value | money_without_trailing_zeros }}{% else %}$0{% endif %}
                  –
                  {% if filter.max_value.value %}{{ filter.max_value.value | money_without_trailing_zeros }}{% else %}Max{% endif %}
                  <svg width="12" height="12" viewBox="0 0 20 20" fill="none"><path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </a>
              {% endif %}
            {% else %}
              {% for value in filter.active_values %}
                <a href="{{ value.url_to_remove }}" class="active-filter-pill">
                  {{ value.label }}
                  <svg width="12" height="12" viewBox="0 0 20 20" fill="none"><path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </a>
              {% endfor %}
            {% endif %}
          {% endfor %}

          {% for tag in current_tags %}
            {%- capture remove_tag_url -%}
              {%- assign active_tags_except_current = "" -%}
              {%- for t in current_tags -%}
                {%- unless t == tag -%}
                  {%- if active_tags_except_current != "" -%}{%- assign active_tags_except_current = active_tags_except_current | append: "+" -%}{%- endif -%}
                  {%- assign active_tag_handle = t | handle -%}
                  {%- assign active_tags_except_current = active_tags_except_current | append: active_tag_handle -%}
                {%- endunless -%}
              {%- endfor -%}
              {{ collection.url }}{% if active_tags_except_current != "" %}/{{ active_tags_except_current }}{% endif %}
            {%- endcapture -%}
            <a href="{{ remove_tag_url }}" class="active-filter-pill">
              {{ tag }}
              <svg width="12" height="12" viewBox="0 0 20 20" fill="none"><path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </a>
          {% endfor %}

          <a href="{{ collection.url }}" class="active-filters__clear">Clear all</a>
        </div>
      </div>
    {% endif %}

    <!-- ===== MAIN LAYOUT ===== -->
    <div class="collection-layout">

      <!-- ===== FILTER SIDEBAR ===== -->
      <aside class="filter-sidebar" id="filter-sidebar" data-filter-sidebar aria-label="Product filters">

        <!-- Sidebar header (mobile) -->
        <div class="filter-sidebar__header">
          <span class="filter-sidebar__title">Filters</span>
          <button class="filter-sidebar__close" data-filter-close aria-label="Close filters">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <form id="FacetFiltersForm" data-filter-form method="get" action="{{ collection.url }}">

          <!-- 1. Categories / Collections Group (Always Available) -->
          <div class="filter-group" data-filter-group>
            <button type="button" class="filter-group__header" data-filter-group-toggle aria-expanded="true">
              <span class="filter-group__label">Category</span>
              <svg class="filter-group__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="filter-group__body">
              <ul class="filter-list">
                <!-- All Products Category link -->
                <li class="filter-list__item">
                  <a href="/collections/all" class="filter-checkbox {% if collection.handle == 'all' %}is-active{% endif %}" style="text-decoration: none; color: inherit;">
                    <span class="filter-checkbox__box">
                      <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                        <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="filter-checkbox__label">All Products</span>
                  </a>
                </li>
                {% for col in collections %}
                  {% unless col.handle == 'frontpage' or col.handle == 'all' %}
                    {% assign col_count = col.all_products_count | default: col.products_count %}
                    {% if col_count > 0 %}
                      <li class="filter-list__item">
                        <a href="{{ col.url }}" class="filter-checkbox {% if collection.handle == col.handle %}is-active{% endif %}" style="text-decoration: none; color: inherit;">
                          <span class="filter-checkbox__box">
                            <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                              <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="filter-checkbox__label">{{ col.title }}</span>
                          <span class="filter-checkbox__count">({{ col_count }})</span>
                        </a>
                      </li>
                    {% endif %}
                  {% endunless %}
                {% endfor %}
              </ul>
            </div>
          </div>

          <!-- Dynamic scanning of Color & Size options from collection products -->
          {%- assign colors_list = "" -%}
          {%- assign sizes_list = "" -%}
          {%- for product in collection.products -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_name_down = option.name | downcase -%}
              {%- if opt_name_down == 'color' or opt_name_down == 'colour' -%}
                {%- for val in option.values -%}
                  {%- assign val_clean = val | strip -%}
                  {%- unless colors_list contains val_clean -%}
                    {%- if colors_list != "" -%}{%- assign colors_list = colors_list | append: "," -%}{%- endif -%}
                    {%- assign colors_list = colors_list | append: val_clean -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- elsif opt_name_down == 'size' -%}
                {%- for val in option.values -%}
                  {%- assign val_clean = val | strip -%}
                  {%- unless sizes_list contains val_clean -%}
                    {%- if sizes_list != "" -%}{%- assign sizes_list = sizes_list | append: "," -%}{%- endif -%}
                    {%- assign sizes_list = sizes_list | append: val_clean -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}

          {%- assign color_array = colors_list | split: "," | uniq -%}
          {%- assign size_array = sizes_list | split: "," | uniq -%}

          <!-- 2. Colors Filter Group (Scanned Variant Options) -->
          {% if color_array.size > 0 %}
            <div class="filter-group" data-filter-group>
              <button type="button" class="filter-group__header" data-filter-group-toggle aria-expanded="true">
                <span class="filter-group__label">Color</span>
                <svg class="filter-group__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="filter-group__body">
                <ul class="filter-list">
                  {% for color_val in color_array %}
                    {%- assign color_clean = color_val | strip -%}
                    {% if color_clean != "" %}
                      {%- assign color_active = false -%}
                      {%- capture color_query -%}filter.v.option.color={{ color_clean }}{%- endcapture -%}
                      {%- if canonical_url contains color_query -%}
                        {%- assign color_active = true -%}
                      {%- endif -%}
                      <li class="filter-list__item">
                        <label class="filter-checkbox {% if color_active %}is-active{% endif %}">
                          <input
                            type="checkbox"
                            name="filter.v.option.color"
                            value="{{ color_clean }}"
                            {% if color_active %}checked{% endif %}
                            class="filter-checkbox__input"
                            data-filter-input
                          >
                          <span class="filter-checkbox__box">
                            <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                              <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="filter-checkbox__label">{{ color_clean }}</span>
                        </label>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}

          <!-- 3. Sizes Filter Group (Scanned Variant Options) -->
          {% if size_array.size > 0 %}
            <div class="filter-group" data-filter-group>
              <button type="button" class="filter-group__header" data-filter-group-toggle aria-expanded="true">
                <span class="filter-group__label">Size</span>
                <svg class="filter-group__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="filter-group__body">
                <ul class="filter-list">
                  {% for size_val in size_array %}
                    {%- assign size_clean = size_val | strip -%}
                    {% if size_clean != "" %}
                      {%- assign size_active = false -%}
                      {%- capture size_query -%}filter.v.option.size={{ size_clean }}{%- endcapture -%}
                      {%- if canonical_url contains size_query -%}
                        {%- assign size_active = true -%}
                      {%- endif -%}
                      <li class="filter-list__item">
                        <label class="filter-checkbox {% if size_active %}is-active{% endif %}">
                          <input
                            type="checkbox"
                            name="filter.v.option.size"
                            value="{{ size_clean }}"
                            {% if size_active %}checked{% endif %}
                            class="filter-checkbox__input"
                            data-filter-input
                          >
                          <span class="filter-checkbox__box">
                            <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                              <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="filter-checkbox__label">{{ size_clean }}</span>
                        </label>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}

          <!-- 4. Price Filter Group -->
          <div class="filter-group" data-filter-group>
            <button type="button" class="filter-group__header" data-filter-group-toggle aria-expanded="true">
              <span class="filter-group__label">Price</span>
              <svg class="filter-group__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="filter-group__body">
              <div class="filter-price">
                <div class="filter-price__inputs">
                  <div class="filter-price__field">
                    <label class="filter-price__label">Min</label>
                    <div class="filter-price__input-wrap">
                      <span class="filter-price__symbol">{{ cart.currency.symbol }}</span>
                      <input
                        type="number"
                        name="filter.v.price.gte"
                        id="Fallback-Price-Min"
                        class="filter-price__input"
                        min="0"
                        placeholder="0"
                        value="{{ canonical_url | split: 'filter.v.price.gte=' | last | split: '&' | first | escape }}"
                        data-filter-price-min
                      >
                    </div>
                  </div>
                  <span class="filter-price__dash">—</span>
                  <div class="filter-price__field">
                    <label class="filter-price__label">Max</label>
                    <div class="filter-price__input-wrap">
                      <span class="filter-price__symbol">{{ cart.currency.symbol }}</span>
                      <input
                        type="number"
                        name="filter.v.price.lte"
                        id="Fallback-Price-Max"
                        class="filter-price__input"
                        min="0"
                        placeholder="Max"
                        value="{{ canonical_url | split: 'filter.v.price.lte=' | last | split: '&' | first | escape }}"
                        data-filter-price-max
                      >
                    </div>
                  </div>
                </div>
                <button type="submit" class="filter-price__apply btn btn--secondary">Apply</button>
              </div>
            </div>
          </div>

          <!-- 5. Availability Group (Stock Status) -->
          <div class="filter-group" data-filter-group>
            <button type="button" class="filter-group__header" data-filter-group-toggle aria-expanded="true">
              <span class="filter-group__label">Availability</span>
              <svg class="filter-group__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="filter-group__body">
              <ul class="filter-list">
                <li class="filter-list__item">
                  {%- assign in_stock_active = false -%}
                  {%- if canonical_url contains 'filter.v.availability=1' -%}
                    {%- assign in_stock_active = true -%}
                  {%- endif -%}
                  <label class="filter-checkbox {% if in_stock_active %}is-active{% endif %}">
                    <input
                      type="checkbox"
                      name="filter.v.availability"
                      value="1"
                      {% if in_stock_active %}checked{% endif %}
                      class="filter-checkbox__input"
                      data-filter-input
                    >
                    <span class="filter-checkbox__box">
                      <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                        <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="filter-checkbox__label">In Stock</span>
                  </label>
                </li>
                <li class="filter-list__item">
                  {%- assign out_of_stock_active = false -%}
                  {%- if canonical_url contains 'filter.v.availability=0' -%}
                    {%- assign out_of_stock_active = true -%}
                  {%- endif -%}
                  <label class="filter-checkbox {% if out_of_stock_active %}is-active{% endif %}">
                    <input
                      type="checkbox"
                      name="filter.v.availability"
                      value="0"
                      {% if out_of_stock_active %}checked{% endif %}
                      class="filter-checkbox__input"
                      data-filter-input
                    >
                    <span class="filter-checkbox__box">
                      <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                        <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="filter-checkbox__label">Out of Stock</span>
                  </label>
                </li>
              </ul>
            </div>
          </div>

          <!-- Fallback Tags Group (if any exist) -->
          {% if collection.all_tags.size > 0 %}
            <div class="filter-group" data-filter-group>
              <button type="button" class="filter-group__header" data-filter-group-toggle aria-expanded="false">
                <span class="filter-group__label">Tags</span>
                <svg class="filter-group__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="filter-group__body">
                <ul class="filter-list">
                  {% for tag in collection.all_tags %}
                    {%- assign tag_clean = tag | strip -%}
                    {% if tag_clean != "" %}
                      <li class="filter-list__item">
                        {% if current_tags contains tag_clean %}
                          {%- capture tag_url -%}
                            {%- assign active_tags_except_current = "" -%}
                            {%- for t in current_tags -%}
                              {%- unless t == tag_clean -%}
                                {%- if active_tags_except_current != "" -%}{%- assign active_tags_except_current = active_tags_except_current | append: "+" -%}{%- endif -%}
                                {%- assign active_tag_handle = t | handle -%}
                                {%- assign active_tags_except_current = active_tags_except_current | append: active_tag_handle -%}
                              {%- endunless -%}
                            {%- endfor -%}
                            {{ collection.url }}{% if active_tags_except_current != "" %}/{{ active_tags_except_current }}{% endif %}
                          {%- endcapture -%}
                          <a href="{{ tag_url }}" class="filter-checkbox is-active" style="text-decoration: none; color: inherit;">
                            <span class="filter-checkbox__box">
                              <svg width="10" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                            <span class="filter-checkbox__label">{{ tag_clean }}</span>
                          </a>
                        {% else %}
                          {%- capture tag_url -%}
                            {%- if current_tags.size > 0 -%}
                              {{ collection.url }}/{{ current_tags | join: '+' }}+{{ tag_clean | handle }}
                            {%- else -%}
                              {{ collection.url }}/{{ tag_clean | handle }}
                            {%- endif -%}
                          {%- endcapture -%}
                          <a href="{{ tag_url }}" class="filter-checkbox" style="text-decoration: none; color: inherit;">
                            <span class="filter-checkbox__box">
                              <svg width="10" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                            <span class="filter-checkbox__label">{{ tag_clean }}</span>
                          </a>
                        {% endif %}
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}

        </form>

      </aside>


      <!-- ===== PRODUCTS AREA ===== -->
      <div class="collection-products">
        {%- assign per_page = section.settings.products_per_page | default: 12 -%}
        {% paginate collection.products by per_page %}

          {% if collection.products_count == 0 %}
            <div class="collection-empty">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" class="collection-empty__icon">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <p class="collection-empty__title">No products found</p>
              <p class="collection-empty__text">Try adjusting your filters or browse all products.</p>
              <a href="{{ collection.url }}" class="btn btn--primary">Clear Filters</a>
            </div>
          {% else %}
            {%- assign grid_columns = section.settings.columns | default: '3' -%}
            <div class="product-grid product-grid--{{ grid_columns }}" data-animate-grid>
              {% for product in collection.products %}
                {% render 'product-card', product: product, show_sale_badge: true %}
              {% endfor %}
            </div>
          {% endif %}

          {% if paginate.pages > 1 %}
            <div class="collection-template__pagination">
              <nav class="pagination" role="navigation" aria-label="Pagination">
                {% if paginate.previous %}
                  <a href="{{ paginate.previous.url }}" class="pagination__btn pagination__btn--prev" aria-label="Previous page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </a>
                {% endif %}
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="pagination__number">{{ part.title }}</a>
                  {% else %}
                    {% if part.title == paginate.current_page %}
                      <span class="pagination__number is-active" aria-current="page">{{ part.title }}</span>
                    {% else %}
                      <span class="pagination__ellipsis">{{ part.title }}</span>
                    {% endif %}
                  {% endif %}
                {% endfor %}
                {% if paginate.next %}
                  <a href="{{ paginate.next.url }}" class="pagination__btn pagination__btn--next" aria-label="Next page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </a>
                {% endif %}
              </nav>
            </div>
          {% endif %}

        {% endpaginate %}
      </div><!-- /.collection-products -->

    </div><!-- /.collection-layout -->
  </div>
</section>

{% schema %}
{
  "name": "Collection Template",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ]
}
{% endschema %}
