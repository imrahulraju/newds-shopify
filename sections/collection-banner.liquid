<section class="collection-banner">
  {%- assign banner_image = collection.image | default: section.settings.bg_image -%}
  <div class="collection-banner__image-wrapper">
    {% if banner_image != blank %}
      <img 
        src="{{ banner_image | image_url: width: 1920 }}"
        alt="{{ collection.title | default: 'Collection' }}"
        width="1920"
        height="400"
        class="collection-banner__image"
        loading="eager"
        onerror="this.onerror=null; this.src='{{ 'sample-collection-banner.jpg' | asset_url }}';"
      >
    {% else %}
      <img 
        src="{{ 'sample-collection-banner.jpg' | asset_url }}"
        alt="{{ collection.title | default: 'Collection' }}"
        width="1920"
        height="400"
        class="collection-banner__image"
        loading="eager"
      >
    {% endif %}
    <div class="collection-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | default: 40 | divided_by: 100.0 }};"></div>
  </div>
  <div class="container">
    <div class="collection-banner__content">
      <h1 class="collection-banner__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-banner__description">{{ collection.description }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Default Banner Image",
      "info": "Used as the fallback banner image if the collection does not have a featured image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 40,
      "unit": "%"
    }
  ]
}
{% endschema %}
