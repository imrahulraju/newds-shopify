<section class="list-collections-page section">
  <div class="container">

    <div class="section__header">
      <p class="section__subtitle">Shop by Category</p>
      <h1 class="section__title">All Collections</h1>
    </div>

    <div class="list-collections__grid" data-animate-grid>
      {% for collection in collections %}
        {% assign col_count = collection.all_products_count | default: collection.products_count %}
        {% unless collection.handle == 'frontpage' or col_count == 0 %}
          <a href="{{ collection.url }}" class="list-collections__item">
            <div class="list-collections__media">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 600 }}"
                  srcset="{{ collection.image | image_url: width: 400 }} 400w,
                          {{ collection.image | image_url: width: 600 }} 600w,
                          {{ collection.image | image_url: width: 800 }} 800w"
                  sizes="(max-width: 480px) 50vw, (max-width: 768px) 33vw, 25vw"
                  alt="{{ collection.title }}"
                  width="600"
                  height="600"
                  loading="lazy"
                  class="list-collections__image"
                >
              {% else %}
                <div class="list-collections__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
              <div class="list-collections__overlay">
                <span class="list-collections__cta btn btn--primary">Shop Now</span>
              </div>
            </div>

            <div class="list-collections__info">
              <h2 class="list-collections__title">{{ collection.title }}</h2>
              {% if collection.description != blank %}
                <p class="list-collections__desc">{{ collection.description | strip_html | truncate: 80 }}</p>
              {% endif %}
              <p class="list-collections__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
            </div>
          </a>
        {% endunless %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .list-collections-page { padding: var(--spacing-xl) 0; }

  .list-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .list-collections__item {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .list-collections__item:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.10);
  }

  .list-collections__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-background-alt);
  }

  .list-collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: block;
  }

  .list-collections__item:hover .list-collections__image {
    transform: scale(1.07);
  }

  .list-collections__placeholder {
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt);
  }

  .list-collections__placeholder .placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .list-collections__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.18);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .list-collections__item:hover .list-collections__overlay {
    opacity: 1;
  }

  .list-collections__cta {
    transform: translateY(8px);
    transition: transform 0.3s ease;
  }

  .list-collections__item:hover .list-collections__cta {
    transform: translateY(0);
  }

  .list-collections__info {
    padding: 1rem;
  }

  .list-collections__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-heading);
    margin-bottom: 0.3rem;
    letter-spacing: 0.01em;
  }

  .list-collections__desc {
    font-size: 0.82rem;
    color: var(--color-text-light);
    line-height: 1.5;
    margin-bottom: 0.4rem;
  }

  .list-collections__count {
    font-size: 0.75rem;
    color: var(--color-text-light);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .list-collections__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .list-collections__grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }

  @media (max-width: 480px) {
    .list-collections__grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .list-collections__title { font-size: 0.9rem; }
  }
</style>

{% schema %}
{
  "name": "List Collections Template",
  "settings": []
}
{% endschema %}
