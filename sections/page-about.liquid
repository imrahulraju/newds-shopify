<section class="about-page section{% if section.settings.bg_image != blank %} has-bg-image{% endif %}" style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% elsif section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  {% if section.settings.bg_image != blank and section.settings.bg_overlay_opacity > 0 %}
    <div class="section-bg-overlay" style="background-color: {{ section.settings.bg_overlay_color | default: '#ffffff' }}; opacity: {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }};"></div>
  {% endif %}
  <div class="about-page__banner-wrapper" style="margin-bottom: var(--spacing-lg); max-width: 1200px; margin-left: auto; margin-right: auto; border-radius: var(--radius-md); overflow: hidden;">
    {% if section.settings.banner_image != blank %}
      <img
        src="{{ section.settings.banner_image | image_url: width: 1400 }}"
        alt="{{ page.title | default: 'About ElyvaraCo' }}"
        width="1400"
        height="600"
        style="width: 100%; height: auto; display: block; max-height: 480px; object-fit: cover;"
        loading="lazy"
        onerror="this.onerror=null; this.src='{{ 'sample-story.jpg' | asset_url }}';"
      >
    {% else %}
      <img
        src="{{ 'sample-story.jpg' | asset_url }}"
        alt="{{ page.title | default: 'About ElyvaraCo' }}"
        width="1400"
        height="600"
        style="width: 100%; height: auto; display: block; max-height: 480px; object-fit: cover;"
        loading="lazy"
      >
    {% endif %}
  </div>
  <div class="container container--narrow">
    <div class="about-page__header">
      <span class="about-page__subtitle">OUR STORY</span>
      <h1 class="about-page__title">{{ page.title | default: 'ABOUT ELYVARACO' }}</h1>
    </div>

    {% if page.content != blank %}
      <div class="about-page__content rte">
        {{ page.content }}
      </div>
    {% else %}
      <div class="about-page__content rte">
        <p class="about-page__lead">Welcome to ElyvaraCo — where timeless elegance meets modern craftsmanship.</p>
        
        <p>At ElyvaraCo, we believe that fine jewelry is more than an accessory; it is an expression of personal style, cherished memories, and everyday luxury. Each piece in our collection is thoughtfully designed and meticulously handcrafted to elevate your everyday glow.</p>

        <h2>Our Mission</h2>
        <p>We are dedicated to providing ethically sourced, premium jewelry designed for the modern woman. From subtle everyday gold accents to showstopping statement pieces, our goal is to inspire confidence and bring timeless beauty to every moment.</p>

        <h2>Craftsmanship & Integrity</h2>
        <p>Quality and sustainability lie at the heart of everything we do. We partner with skilled artisans who share our passion for detail, using premium metals and hand-selected stones designed to last a lifetime.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "About Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Hero Story Banner Image"
    },
    {
      "type": "header",
      "content": "Background & Style"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 10,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
