{%- assign current_country = localization.country -%}
{%- if current_country -%}
  {%- assign display_name = current_country.name -%}
  {%- assign display_currency = current_country.currency.iso_code -%}
{%- else -%}
  {%- assign display_name = 'United States' -%}
  {%- assign display_currency = 'USD' -%}
{%- endif -%}

<footer class="ftr{% if section.settings.bg_image != blank %} has-bg-image{% endif %}" style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}'); background-size: cover; background-position: center; position: relative;{% elsif section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  {% if section.settings.bg_image != blank and section.settings.bg_overlay_opacity > 0 %}
    <div class="section-bg-overlay" style="background-color: {{ section.settings.bg_overlay_color | default: '#000000' }}; opacity: {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }};"></div>
  {% endif %}

  <!-- Gem Divider -->
  <div class="ftr__divider">
    <span class="ftr__divider-line"></span>
    <span class="ftr__divider-gem" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 2L2 9l10 13L22 9 12 2z" stroke="#c9a84c" stroke-width="1.4" fill="none" stroke-linejoin="round"/>
        <path d="M2 9h20M7 9L12 2M17 9L12 2M7 9l5 13M17 9l-5 13" stroke="#c9a84c" stroke-width="1" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="ftr__divider-line"></span>
  </div>

  <!-- Main Grid -->
  <div class="ftr__body">



    <!-- Col 2: Links (two sub-columns) -->
    <div class="ftr__col ftr__col--links">
      <div class="ftr__links-group">
        <h4 class="ftr__col-heading">EXPLORE</h4>
        <ul class="ftr__links-list">
          {% if section.settings.menu_left != blank %}
            {% for link in linklists[section.settings.menu_left].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/">Home</a></li>
            <li><a href="/collections">Collections</a></li>
            <li><a href="/collections/new-arrivals">New Arrivals</a></li>
            <li><a href="/pages/contact-us">Contact Us</a></li>
          {% endif %}
        </ul>
      </div>
      <div class="ftr__links-group">
        <h4 class="ftr__col-heading">INFORMATION</h4>
        <ul class="ftr__links-list">
          <li><a href="/pages/shipping">Shipping</a></li>
          <li><a href="/pages/returns">Returns & Refunds</a></li>
          <li><a href="/pages/size-fit">Size &amp; Fit</a></li>
          <li><a href="/pages/jewellery-care">Jewellery Care</a></li>
          <li><a href="/pages/privacy-rights">Privacy</a></li>
          <li><a href="/pages/service-terms">Terms</a></li>
        </ul>
      </div>
    </div>

    <!-- Col 3: Social + Newsletter -->
    <div class="ftr__col ftr__col--social">
      <h4 class="ftr__col-heading">FOLLOW US</h4>
      <ul class="ftr__social-list">
        <li>
          <a href="{{ settings.social_instagram | default: '#' }}" target="_blank" rel="noopener noreferrer" class="ftr__social-link">Instagram</a>
        </li>
        <li>
          <a href="{{ settings.social_tiktok | default: '#' }}" target="_blank" rel="noopener noreferrer" class="ftr__social-link">TikTok</a>
        </li>
        <li>
          <a href="{{ settings.social_youtube | default: '#' }}" target="_blank" rel="noopener noreferrer" class="ftr__social-link">YouTube</a>
        </li>
        <li>
          <a href="{{ settings.social_facebook | default: '#' }}" target="_blank" rel="noopener noreferrer" class="ftr__social-link">Facebook</a>
        </li>
      </ul>

    </div>

  </div><!-- /.ftr__body -->

  <!-- Bottom Bar -->
  <div class="ftr__bottom">

    <!-- Country Selector -->
    <div class="ftr__country-selector">
      {%- form 'localization', id: 'FooterLocalizationForm' -%}
        <input type="hidden" name="country_code" id="FooterCountryInput" value="{{ current_country.iso_code | default: 'US' }}">
        <button
          type="button"
          class="ftr__country-btn"
          data-country-btn
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Select country"
        >
          <span class="ftr__flag-iso">{{ current_country.iso_code | default: 'US' }}</span>
          <span class="ftr__country-text">{{ display_name }} &middot; {{ display_currency }}</span>
          <svg class="ftr__country-chevron" width="9" height="5" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="ftr__country-dropdown" data-country-dropdown role="listbox" aria-label="Countries">
          <ul class="ftr__country-list">
            {%- for country in localization.available_countries -%}
              {%- if country.iso_code == current_country.iso_code -%}
                {%- assign is_sel = 'true' -%}
              {%- else -%}
                {%- assign is_sel = 'false' -%}
              {%- endif -%}
              <li role="option" aria-selected="{{ is_sel }}">
                <a
                  href="#"
                  class="ftr__country-link{% if country.iso_code == current_country.iso_code %} is-active{% endif %}"
                  data-country-code="{{ country.iso_code }}"
                >
                  <span>{{ country.name }}</span>
                  <span class="ftr__country-cur">{{ country.currency.iso_code }}</span>
                </a>
              </li>
            {%- else -%}
              <li role="option" aria-selected="true">
                <a href="#" class="ftr__country-link is-active" data-country-code="US">
                  <span>United States</span>
                  <span class="ftr__country-cur">USD</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endform -%}
    </div>

    <!-- Copyright -->
    <p class="ftr__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>

    <!-- Payment Icons -->
    <div class="ftr__payments">
      {%- if section.settings.show_payment_icons -%}
        {%- for type in shop.enabled_payment_types -%}
          <span class="ftr__pay-icon">{{ type | payment_type_svg_tag }}</span>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div><!-- /.ftr__bottom -->

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Name",
      "default": "ELYVARACO"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Timeless elegance, crafted for you."
    },
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand Description",
      "default": "Discover curated collections of ethically sourced, artisanal fine jewelry. Each piece tells a story of timeless beauty."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "info@elyvaraco.com"
    },
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Explore Menu",
      "info": "Overrides the default Explore links."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Background & Style"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
