<section class="customer-page section">
  <div class="container">
    <div class="account-header">
      <div class="account-header__text">
        <p class="section__subtitle">My Account</p>
        <h1 class="section__title">Manage Addresses</h1>
      </div>
      <a href="/account" class="btn btn--secondary">Back to Account</a>
    </div>

    <!-- Add new address -->
    <div class="account-section">
      <h2 class="account-section__title">Add a New Address</h2>
      {% form 'customer_address', customer.new_address %}
        {% if form.errors %}
          <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">First Name</label>
            <input type="text" name="address[first_name]" class="form-input" value="{{ form.first_name }}" autocomplete="given-name">
          </div>
          <div class="form-group">
            <label class="form-label">Last Name</label>
            <input type="text" name="address[last_name]" class="form-input" value="{{ form.last_name }}" autocomplete="family-name">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Company (optional)</label>
          <input type="text" name="address[company]" class="form-input" value="{{ form.company }}">
        </div>
        <div class="form-group">
          <label class="form-label">Address</label>
          <input type="text" name="address[address1]" class="form-input" value="{{ form.address1 }}" autocomplete="address-line1" required>
        </div>
        <div class="form-group">
          <label class="form-label">Apartment, suite, etc. (optional)</label>
          <input type="text" name="address[address2]" class="form-input" value="{{ form.address2 }}" autocomplete="address-line2">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">City</label>
            <input type="text" name="address[city]" class="form-input" value="{{ form.city }}" autocomplete="address-level2" required>
          </div>
          <div class="form-group">
            <label class="form-label">Country</label>
            <select name="address[country]" class="form-input" id="AddressCountryNew">
              {{ all_country_option_tags }}
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">State / Province</label>
            <input type="text" name="address[province]" class="form-input" value="{{ form.province }}" autocomplete="address-level1">
          </div>
          <div class="form-group">
            <label class="form-label">Zip / Postal Code</label>
            <input type="text" name="address[zip]" class="form-input" value="{{ form.zip }}" autocomplete="postal-code">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Phone</label>
          <input type="tel" name="address[phone]" class="form-input" value="{{ form.phone }}" autocomplete="tel">
        </div>
        <div class="form-group form-group--checkbox">
          <input type="checkbox" id="address_default_address_new" name="address[default]" value="1">
          <label for="address_default_address_new">Set as default address</label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Add Address</button>
        </div>
      {% endform %}
    </div>

    <!-- Existing addresses -->
    {% if customer.addresses.size > 0 %}
      <div class="account-section">
        <h2 class="account-section__title">Saved Addresses</h2>
        <div class="addresses-grid">
          {% for address in customer.addresses %}
            <div class="address-card {% if address == customer.default_address %}address-card--default{% endif %}">
              {% if address == customer.default_address %}
                <span class="address-card__badge">Default</span>
              {% endif %}
              <address class="address-card__text">
                {{ address | format_address }}
              </address>
              <div class="address-card__actions">
                <button class="form-link" onclick="Shopify.CustomerAddress.toggleForm({{ address.id }})">Edit</button>
                <button class="form-link form-link--danger" onclick="Shopify.CustomerAddress.destroy('{{ address.id }}', '{{ 'customers.addresses.delete_confirm' | t }}')" >Delete</button>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{ "name": "Addresses Template", "settings": [] }
{% endschema %}
