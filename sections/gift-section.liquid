<section class="gift-section section{% if section.settings.bg_image != blank %} has-bg-image{% endif %}" style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% elsif section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  {% if section.settings.bg_image != blank and section.settings.bg_overlay_opacity > 0 %}
    <div class="section-bg-overlay" style="background-color: {{ section.settings.bg_overlay_color | default: '#ffffff' }}; opacity: {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }};"></div>
  {% endif %}
  <div class="container">
    <div class="gift-section__inner">
      <div class="gift-section__media">
        {% if section.settings.image != blank %}
          <img 
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="{{ section.settings.image | image_url: width: 500 }} 500w,
                    {{ section.settings.image | image_url: width: 800 }} 800w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ section.settings.title | default: 'Gift Section' }}"
            width="800"
            height="600"
            loading="lazy"
            class="gift-section__image"
            onerror="this.onerror=null; this.src='{{ 'sample-gift.jpg' | asset_url }}';"
          >
        {% else %}
          <img 
            src="{{ 'sample-gift.jpg' | asset_url }}"
            alt="{{ section.settings.title | default: 'Gift Section' }}"
            width="800"
            height="600"
            loading="lazy"
            class="gift-section__image"
          >
        {% endif %}
      </div>

      <div class="gift-section__content">
        {% if section.settings.subtitle != blank %}
          <p class="gift-section__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="gift-section__title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="gift-section__description">{{ section.settings.description }}</div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Special Offer"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Free Gift"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Get a free gift with every order over $75. Choose from our selection of beautiful accessories.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F9F7F4"
    },
    {
      "type": "header",
      "content": "Background Image & Style"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 10,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Gift Section"
    }
  ]
}
{% endschema %}
