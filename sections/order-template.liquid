<section class="customer-page section">
  <div class="container">
    <div class="account-header">
      <div class="account-header__text">
        <p class="section__subtitle">My Account</p>
        <h1 class="section__title">Order {{ order.name }}</h1>
      </div>
      <a href="/account" class="btn btn--secondary">Back to Account</a>
    </div>

    <div class="order-meta">
      <p class="order-meta__date">Placed on {{ order.created_at | date: "%B %d, %Y" }}</p>
      <span class="account-orders__badge account-orders__badge--{{ order.financial_status }}">{{ order.financial_status_label }}</span>
    </div>

    <div class="account-grid">

      <!-- Line items -->
      <div class="account-section">
        <h2 class="account-section__title">Items</h2>
        <div class="order-items">
          {% for line_item in order.line_items %}
            <div class="order-item">
              {% if line_item.image %}
                <img src="{{ line_item.image | image_url: width: 100 }}" alt="{{ line_item.title }}" width="100" height="100" class="order-item__image">
              {% endif %}
              <div class="order-item__info">
                <p class="order-item__title">{{ line_item.title }}</p>
                {% if line_item.variant.title != 'Default Title' %}
                  <p class="order-item__variant">{{ line_item.variant.title }}</p>
                {% endif %}
                <p class="order-item__qty">Qty: {{ line_item.quantity }}</p>
              </div>
              <p class="order-item__price">{{ line_item.final_line_price | money }}</p>
            </div>
          {% endfor %}
        </div>

        <div class="order-totals">
          <div class="order-totals__row">
            <span>Subtotal</span>
            <span>{{ order.subtotal_price | money }}</span>
          </div>
          {% for shipping_method in order.shipping_methods %}
            <div class="order-totals__row">
              <span>Shipping ({{ shipping_method.title }})</span>
              <span>{{ shipping_method.price | money }}</span>
            </div>
          {% endfor %}
          {% for tax_line in order.tax_lines %}
            <div class="order-totals__row">
              <span>{{ tax_line.title }} ({{ tax_line.rate | times: 100 }}%)</span>
              <span>{{ tax_line.price | money }}</span>
            </div>
          {% endfor %}
          <div class="order-totals__row order-totals__row--total">
            <span>Total</span>
            <span>{{ order.total_price | money }}</span>
          </div>
        </div>
      </div>

      <!-- Addresses -->
      <div class="account-section">
        {% if order.billing_address %}
          <h2 class="account-section__title">Billing Address</h2>
          <address class="account-address">{{ order.billing_address | format_address }}</address>
        {% endif %}
        {% if order.shipping_address %}
          <h2 class="account-section__title" style="margin-top:1.5rem;">Shipping Address</h2>
          <address class="account-address">{{ order.shipping_address | format_address }}</address>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{ "name": "Order Template", "settings": [] }
{% endschema %}
