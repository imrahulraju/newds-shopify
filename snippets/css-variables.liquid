{% comment %}
  CSS Variables - outputs theme settings as CSS custom properties
{% endcomment %}

<style>
  :root {
    /* Colors */
    --color-primary: {{ settings.color_primary | default: '#8D7865' }};
    --color-secondary: {{ settings.color_secondary | default: '#F9F8F7' }};
    --color-accent: {{ settings.color_accent | default: '#7A6856' }};
    --color-text: {{ settings.color_text | default: '#2C2C2C' }};
    --color-text-light: {{ settings.color_text_light | default: '#666666' }};
    --color-heading: {{ settings.color_heading | default: '#8D7865' }};
    --color-background: {{ settings.color_background | default: '#FFFFFF' }};
    --color-background-alt: {{ settings.color_background_alt | default: '#F8F7F6' }};
    --color-button: {{ settings.color_button | default: '#1A1A1A' }};
    --color-button-text: {{ settings.color_button_text | default: '#FFFFFF' }};
    --color-border: #F0EEEC;
    --color-star: #8D7865;
    --color-success: #2E7D32;
    --color-error: #E74C3C;

    /* Typography */
    --font-heading: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-heading-weight: 600;
    --font-heading-style: normal;
    --font-body: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-body-weight: 400;
    --font-body-style: normal;
    --font-body-size: 14px;
    --font-accent: 'Playfair Display', Georgia, serif;

    /* Spacing */
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 1.5rem;
    --spacing-lg: 2.5rem;
    --spacing-xl: 4rem;
    --spacing-2xl: 6rem;

    /* Layout */
    --container-width: 1400px;
    --container-narrow: 900px;
    --header-height: 80px;
    --announcement-height: 40px;

    /* Border Radius */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --radius-full: 9999px;

    /* Shadows */
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.12);

    /* Transitions */
    --transition-fast: 150ms ease;
    --transition-base: 300ms ease;
    --transition-slow: 500ms ease;
  }
</style>
